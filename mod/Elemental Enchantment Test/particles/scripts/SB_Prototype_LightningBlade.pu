            box_height 8
            box_depth 0.7
            direction 0 1 0
            angle 3
            time_to_live dyn_random
            {
                min 0.30
                max 0.42
            }
            velocity 1.5
            particle_width dyn_random
            {
                min 0.7
                max 1.2
            }
            particle_height dyn_random
            {
                min 2.3
                max 3.8
            }
        }
        affector TextureRotator
        {
            rotation dyn_random
            {
                min -0.45
                max 0.45
            }
            rotation_speed 0
        }
        affector Colour
        {
            time_colour 0 0.4 0.75 1 0
            time_colour 0.15 0.55 0.8 1 1
            time_colour 1 0.1 0.3 1 0
        }
    }
    technique SoftGlow
