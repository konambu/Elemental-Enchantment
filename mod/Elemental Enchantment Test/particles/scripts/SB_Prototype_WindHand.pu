system SB_Prototype_WindHand
{
    category kenshi_particles
    technique WindStreaks
    {
        visual_particle_quota 64
        material SB_WindWisp
        renderer Billboard
        {
            billboard_rotation_type vertex
        }
        emitter Box Wind
        {
            emission_rate 22
            position 0 0 0
            box_width 0.1
            box_height 1.4
            box_depth 0.1
            keep_local true
            direction 0 1 0
            angle 8
            time_to_live dyn_random
            {
                min 1.0
                max 1.5
            }
            velocity dyn_random
            {
                min 0.3
                max 0.7
            }
            particle_width dyn_random
            {
                min 0.6
                max 1.0
            }
            particle_height dyn_random
            {
                min 1.4
                max 2.2
            }
        }
        affector TextureRotator
        {
            rotation dyn_random
            {
                min -0.12
                max 0.12
            }
            rotation_speed 0
        }
        affector Colour
        {
            time_colour 0 0.7 0.9 1 0
            time_colour 0.2 0.85 1 0.95 0.3
            time_colour 1 0.6 0.8 1 0
        }
    }

}
