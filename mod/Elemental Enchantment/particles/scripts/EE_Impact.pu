system EE_Impact_Fire
{
    category kenshi_particles
    technique Burst
    {
        visual_particle_quota 40
        material Flame1
        renderer Billboard
        {
        }
        emitter Box Burst
        {
            emission_rate 160
            duration 0.15
            repeat_delay 100
            box_width 3
            box_height 3
            box_depth 3
            direction 0 1 0
            angle 180
            time_to_live dyn_random
            {
                min 0.35
                max 0.7
            }
            velocity dyn_random
            {
                min 4
                max 9
            }
            particle_width dyn_random
            {
                min 1.62
                max 2.7
            }
            particle_height dyn_random
            {
                min 1.62
                max 2.7
            }
        }
        affector Colour
        {
            time_colour 0 1 0.25 0.03 0
            time_colour 0.15 1 0.5 0.08 0.85
            time_colour 1 0.35 0.03 0.01 0
        }
    }
}

