system SB_Prototype_IceHand
{
    category kenshi_particles
    technique ColdMist
    {
        visual_particle_quota 28
        material SB_ColdMist
        renderer Billboard
        {
            billboard_rotation_type vertex
        }
        emitter Box Mist
        {
            emission_rate 10
            position 0 0 0
            box_width 0.15
            box_height 1.4
            box_depth 0.15
            direction 0 1 0
            angle 25
            time_to_live dyn_random
            {
                min 1
                max 1.5
            }
            velocity dyn_random
            {
                min 0.1
                max 0.4
            }
            particle_width dyn_random
            {
                min 1.2
                max 2
            }
            particle_height dyn_random
            {
                min 1.6
                max 2.4
            }
        }
        affector Colour
        {
            time_colour 0 0.8 0.95 1 0
            time_colour 0.2 0.78 0.93 1 0.4
            time_colour 1 0.55 0.8 1 0
        }
    }

}
