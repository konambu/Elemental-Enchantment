system SB_Prototype_WaterBlade
{
    category kenshi_particles
    technique WaterSplashes
    {
        visual_particle_quota 35
        material Footsplash[A]
        renderer Billboard
        {
            billboard_type oriented_self
            billboard_rotation_type vertex
        }
        emitter Box Drops
        {
            emission_rate 24
            position 0 5 0
            box_width 0.15
            box_height 7
            box_depth 0.15
            direction 0 1 0
            angle 20
            time_to_live dyn_random
            {
                min 0.6
                max 0.95
            }
            velocity dyn_random
            {
                min 0.2
                max 0.7
            }
            particle_width dyn_random
            {
                min 0.4
                max 0.8
            }
            particle_height dyn_random
            {
                min 0.4
                max 0.8
            }
        }
        affector TextureRotator
        {
            rotation dyn_random
            {
                min -0.5
                max 0.5
            }
            rotation_speed 0
        }
        affector Colour
        {
            time_colour 0 0.3 0.65 1 0
            time_colour 0.18 0.5 0.8 1 0.6
            time_colour 1 0.12 0.45 1 0
        }
    }

    technique FlowingWater
    {
        visual_particle_quota 64
        material Footsplash[A]
        renderer Billboard
        {
            billboard_type oriented_self
            billboard_rotation_type vertex
        }
        emitter Box Rivulets
        {
            emission_rate 28
            position 0 5 0
            box_width 0.5
            box_height 8.5
            box_depth 0.3
            direction 0 1 0
            angle 8
            time_to_live dyn_random
            {
                min 0.5
                max 1.0
            }
            velocity dyn_random
            {
                min 0.5
                max 1.5
            }
            particle_width dyn_random
            {
                min 0.7
                max 1.1
            }
            particle_height dyn_random
            {
                min 1.0
                max 1.8
            }
        }
        affector TextureRotator
        {
            rotation dyn_random
            {
                min -0.6
                max 0.6
            }
            rotation_speed 0
        }
        affector Colour
        {
            time_colour 0 0.15 0.5 1 0
            time_colour 0.2 0.3 0.7 1 0.6
            time_colour 1 0.12 0.45 1 0
        }
    }
}
